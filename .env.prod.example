# ─── URLs publiques ───────────────────────────────────────────────────────────
WEB_URL=https://royalvibe.tondomaine.com
API_URL=https://api.royalvibe.tondomaine.com
S3_PUBLIC_URL=https://s3.royalvibe.tondomaine.com
S3_HOSTNAME=s3.royalvibe.tondomaine.com

# ─── MongoDB ──────────────────────────────────────────────────────────────────
MONGO_USER=royalvibe_admin
MONGO_PASSWORD=CHANGE_MOI_mot_de_passe_mongo_fort

# ─── MinIO ────────────────────────────────────────────────────────────────────
MINIO_USER=royalvibe_minio
MINIO_PASSWORD=CHANGE_MOI_mot_de_passe_minio_fort

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Génère avec : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_MOI_secret_jwt_64_caracteres_minimum

# ─── CORS / Socket.IO ─────────────────────────────────────────────────────────
# Origines autorisées (contrôle des connexions Socket.IO + long-polling).
# Format : LISTE comma-separated d'origines HTTP/HTTPS STRICTES (pas de secret).
#   - protocole http: ou https: obligatoire
#   - pas de chemin, query, fragment, user:pass@, slash de fin, wildcard "*"
#     (chaque origine est comparée par ÉGALITÉ EXACTE — jamais de sous-domaine)
#   - valeurs vides et doublons ignorés
# Ce champ n'est PAS un secret — il porte les origines publiques du frontend.
#
# Exemple (à ADAPTER avant déploiement — origine vercel.app de production) :
#   CORS_ORIGIN=https://royalvibe-cosmetic.vercel.app
#
# En production, le gateway REFUSE de démarrer si CORS_ORIGIN est absent ou
# vide ("no open default"). En dev/test, un fallback local limité s'applique.
# Ne PAS durcir dans le Gateway : la valeur est lue depuis cette variable.
CORS_ORIGIN=https://royalvibe-cosmetic.vercel.app

# ─── Inscription publique (0B.5) ─────────────────────────────────────────────
# REGISTRE PUBLIC OUVERT — désactivé PAR DÉFAULT. Seule la valeur EXACTE
# `true` active POST /auth/register ; toute autre valeur (absente, `false`,
# invalide) le refuse avec HTTP 403 et le code stable REGISTRATION_DISABLED.
# Backend = autorité finale, quel que soit le flag frontend.
#   - `PUBLIC_REGISTRATION_ENABLED`        : côté API (runtime, lu par le
#     contrôleur à chaque requête). Ne PAS mettre `true` en production tant
#     que le système sécurisé (OWNER + organisation + invites) n'est pas prêt.
#   - `NEXT_PUBLIC_REGISTRATION_ENABLED`   : côté web (build-time, affichage
#     SEUL du lien/formulaire d'inscription ; inliné par `next build`).
# Fermeture TEMPORAIRE, remplacée par l'inscription du gérant (OWNER), la
# création de son organisation et l'invitation sécurisée des vendeurs.
# Aucun des deux n'est un secret.
PUBLIC_REGISTRATION_ENABLED=false
NEXT_PUBLIC_REGISTRATION_ENABLED=false

# ─── Rate limiting du login / reverse proxy (0B.6) ───────────────────────────
# `TRUST_PROXY_HOPS` : nombre EXACT de proxys approuvés entre le client et l'API.
# Contrôle comment Express calcule `req.ip` (source de la clé de limitation)
# — jamais une lecture manuelle de `X-Forwarded-For`.
#   - absent / vide / `0` : AUCUN proxy approuvé → on ne se fie à `req.ip`
#     qu'au sens socket (une `X-Forwarded-For` falsifiée ne contourne PAS la
#     limite) ;
#   - entier strictement positif : ce nombre exact de proxys approuvés ;
#   - négatif / décimal / texte : démarrage bloqué (erreur stricte, aucun
#     défaut deviné pour la production).
# Le déploiement actuel (docker-compose + nginx) ne prouve pas un nombre de
# proxy supérieur à celui déjà géré par Express par défaut : la valeur ci-dessous
# est DONC `0`. MESURER le nombre de proxys réels entre l'internet et l'API
# (chaque `proxy_pass` compte) puis configurer cette variable avant production.
# Ce n'est pas un secret.
# TRUST_PROXY_HOPS=0

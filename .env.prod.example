# ─── URLs publiques ───────────────────────────────────────────────────────────
WEB_URL=https://stock-master.app
API_URL=https://api.stock-master.app
# Stockage privé : plus d'URL publique d'images (S3_PUBLIC_URL n'est plus lue
# par l'API). S3_HOSTNAME = hôte public (vhost nginx `s3.`, lecture seule) pour
# lequel l'API signe les URL GET (`S3_SIGNING_ENDPOINT=https://<S3_HOSTNAME>`).
S3_HOSTNAME=s3.stock-master.app

# ─── MongoDB ──────────────────────────────────────────────────────────────────
MONGO_USER=stockmaster_admin
MONGO_PASSWORD=CHANGE_MOI_mot_de_passe_mongo_fort

# ─── MinIO ────────────────────────────────────────────────────────────────────
MINIO_USER=stockmaster_minio
MINIO_PASSWORD=CHANGE_MOI_mot_de_passe_minio_fort

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Génère avec : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_MOI_secret_jwt_64_caracteres_minimum

# ─── CORS / Socket.IO ─────────────────────────────────────────────────────────
# Origines autorisées (contrôle des connexions Socket.IO + long-polling).
# Format : LISTE comma-separated d'origines HTTP/HTTPS STRICTES (pas de secret).
#   - protocole http: ou https: obligatoire
#   - pas de chemin, query, fragment, user:pass@, slash de fin, wildcard "*"
#     (chaque origine est comparée par ÉGALITÉ EXACTE — jamais de sous-domaine)
#   - valeurs vides et doublons ignorés
# Ce champ n'est PAS un secret — il porte les origines publiques du frontend.
#
# Exemple (à ADAPTER avant déploiement — origine vercel.app de production) :
#   CORS_ORIGIN=https://stock-master.app
#
# En production, le gateway REFUSE de démarrer si CORS_ORIGIN est absent ou
# vide ("no open default"). En dev/test, un fallback local limité s'applique.
# Ne PAS durcir dans le Gateway : la valeur est lue depuis cette variable.
CORS_ORIGIN=https://stock-master.app

# ─── Liens d'invitation (1-12G) ──────────────────────────────────────────────
# Origine publique du frontend (http(s), sans chemin) : l'API construit le lien
# d'acceptation `${PUBLIC_APP_URL}/auth/invitations/accept?token=…`, que le
# créateur copie et transmet lui-même (aucun email envoyé). Vide → WEB_URL
# (docker-compose.prod.yml) ; invalide → création d'invitation refusée (503).
PUBLIC_APP_URL=

# ─── Vérification des emails (1-13A, Resend) ────────────────────────────────
# `RESEND_API_KEY` : SECRET (jamais commité ni journalisé). `EMAIL_FROM` :
# expéditeur sur un domaine VÉRIFIÉ dans Resend (`adresse@domaine` ou
# `Nom <adresse@domaine>`). Le lien de confirmation réutilise PUBLIC_APP_URL
# (à défaut WEB_URL) : `${PUBLIC_APP_URL}/auth/verify-email?token=…`.
# Absent/invalide → comptes créés NON vérifiés (connexion impossible tant que
# l'adresse n'est pas confirmée) et renvoi en 503 EMAIL_DELIVERY_UNAVAILABLE.
RESEND_API_KEY=
EMAIL_FROM=Stock Master <no-reply@tondomaine.com>

# ─── Inscription publique (0B.5) ─────────────────────────────────────────────
# REGISTRE PUBLIC OUVERT — désactivé PAR DÉFAULT. Seule la valeur EXACTE
# `true` active POST /auth/register ; toute autre valeur (absente, `false`,
# invalide) le refuse avec HTTP 403 et le code stable REGISTRATION_DISABLED.
# Backend = autorité finale, quel que soit le flag frontend.
#   - `PUBLIC_REGISTRATION_ENABLED`        : côté API (runtime, lu par le
#     contrôleur à chaque requête). Ne PAS mettre `true` en production tant
#     que le système sécurisé (OWNER + organisation + invites) n'est pas prêt.
#   - `NEXT_PUBLIC_REGISTRATION_ENABLED`   : côté web (build-time, affichage
#     SEUL du lien/formulaire d'inscription ; inliné par `next build`).
# Fermeture TEMPORAIRE, remplacée par l'inscription du gérant (OWNER), la
# création de son organisation et l'invitation sécurisée des vendeurs.
# Aucun des deux n'est un secret.
PUBLIC_REGISTRATION_ENABLED=false
NEXT_PUBLIC_REGISTRATION_ENABLED=false

# ─── Anti-robot de l'inscription (1-18C, Cloudflare Turnstile) ──────────────
# Obligatoire AVANT d'ouvrir l'inscription : sans clé, toute inscription est
# refusée (503). Le même widget sert au défi de récupération d'accès (action
# `login`) quand le plafond d'échecs d'un compte est atteint : sans clé, le
# titulaire attend la fin de la fenêtre (15 min). 1-18D : il protège aussi
# les demandes de lien de réinitialisation et de vérification d'e-mail, qui
# sont REFUSÉES (503) sans clé. `TURNSTILE_SECRET_KEY` est un SECRET (API seulement) ;
# `NEXT_PUBLIC_TURNSTILE_SITE_KEY` est la clé PUBLIQUE du même widget (web,
# inlinée au build). Hôtes : noms exacts du web, sans schéma ni port.
# Clés de test Cloudflare et simulation refusées en production.
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=www.stock-master.app
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ─── Reverse proxy et adresse cliente (0B.6, 1-14D.2E) ───────────────────────
# La limitation de débit par IP utilise `req.ip` d'Express, jamais une
# lecture manuelle de `X-Forwarded-For`.
#
# Topologie docker-compose.prod.yml : Internet → nginx (80/443) → API.
# L'API n'a aucun port publié. nginx la joint via le réseau dédié `edge`,
# depuis une adresse FIXE, et l'API n'approuve QUE cette adresse
# (`TRUST_PROXY_ADDRESSES` est dérivée de `PROXY_NGINX_EDGE_ADDRESS` dans le
# compose). nginx RECONSTRUIT `X-Forwarded-For`/`X-Real-IP` depuis la
# connexion observée : une valeur fournie par le client est écrasée.
#
# Ne pas modifier sans raison ; si le sous-réseau entre en conflit avec un
# réseau de l'hôte, changer les TROIS valeurs ensemble (adresse de nginx dans
# le sous-réseau, différente de la passerelle `.1` et HORS de la plage
# dynamique). Ce ne sont pas des secrets.
PROXY_EDGE_SUBNET=172.31.250.0/29
PROXY_NGINX_EDGE_ADDRESS=172.31.250.2
# Plage d'allocation dynamique (API) : dans le sous-réseau, SANS l'adresse
# de nginx.
PROXY_EDGE_DYNAMIC_RANGE=172.31.250.4/30
#
# `TRUST_PROXY_HOPS` n'est PAS transmis par docker-compose.prod.yml (un
# nombre de sauts n'est pas sûr quand d'autres conteneurs peuvent joindre
# l'API directement). Pour un AUTRE déploiement (ex. plateforme avec son
# propre proxy d'entrée), voir docs/architecture/phase-1-14d2e-proxy-client-ip.md :
# `TRUST_PROXY_ADDRESSES` (adresses exactes) ou `TRUST_PROXY_HOPS` (N sauts,
# seulement si TOUS les chemins traversent exactement N proxys), jamais les
# deux, à MESURER sur le déploiement réel.

# ─── URLs publiques ───────────────────────────────────────────────────────────
WEB_URL=https://royalvibe.tondomaine.com
API_URL=https://api.royalvibe.tondomaine.com
S3_PUBLIC_URL=https://s3.royalvibe.tondomaine.com
S3_HOSTNAME=s3.royalvibe.tondomaine.com

# ─── MongoDB ──────────────────────────────────────────────────────────────────
MONGO_USER=royalvibe_admin
MONGO_PASSWORD=CHANGE_MOI_mot_de_passe_mongo_fort

# ─── MinIO ────────────────────────────────────────────────────────────────────
MINIO_USER=royalvibe_minio
MINIO_PASSWORD=CHANGE_MOI_mot_de_passe_minio_fort

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Génère avec : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_MOI_secret_jwt_64_caracteres_minimum

# ─── CORS / Socket.IO ─────────────────────────────────────────────────────────
# Origines autorisées (contrôle des connexions Socket.IO + long-polling).
# Format : LISTE comma-separated d'origines HTTP/HTTPS STRICTES (pas de secret).
#   - protocole http: ou https: obligatoire
#   - pas de chemin, query, fragment, user:pass@, slash de fin, wildcard "*"
#     (chaque origine est comparée par ÉGALITÉ EXACTE — jamais de sous-domaine)
#   - valeurs vides et doublons ignorés
# Ce champ n'est PAS un secret — il porte les origines publiques du frontend.
#
# Exemple (à ADAPTER avant déploiement — origine vercel.app de production) :
#   CORS_ORIGIN=https://royalvibe-cosmetic.vercel.app
#
# En production, le gateway REFUSE de démarrer si CORS_ORIGIN est absent ou
# vide ("no open default"). En dev/test, un fallback local limité s'applique.
# Ne PAS durcir dans le Gateway : la valeur est lue depuis cette variable.
CORS_ORIGIN=https://royalvibe-cosmetic.vercel.app

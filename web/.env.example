NEXT_PUBLIC_API_URL=http://localhost:4000

# 1-18C - Cloudflare Turnstile on sign-up: PUBLIC site key (never the
# secret key). Local development: Cloudflare test key 1x00000000000000000000AA.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Local network-free checkbox (tests, recipe); the API refuses simulation
# whenever NODE_ENV=production.
# NEXT_PUBLIC_TURNSTILE_SIMULATED=false

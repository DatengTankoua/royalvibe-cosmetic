{
  "name": "heyama-test",
  "version": "1.0.0",
  "description": "Heyama technical test — Objects manager (NestJS + Next.js + MongoDB + S3)",
  "private": true,
  "license": "ISC",
  "type": "module",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.1.3",
      "onFail": "download"
    }
  },
  "scripts": {
    "prepare": "husky",
    "lint": "pnpm --filter api lint && pnpm --filter web lint",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}

{
  "name": "heyama-test",
  "version": "1.0.0",
  "description": "Heyama technical test — Objects manager (NestJS + Next.js + MongoDB + S3)",
  "private": true,
  "license": "ISC",
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "prepare": "husky",
    "lint": "pnpm --filter api lint && pnpm --filter web lint",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3"
  },
  "lint-staged": {
  "api/**/*.ts": [
    "pnpm --filter api exec eslint --fix",
    "prettier --write"
  ],
  "web/**/*.{ts,tsx}": [
    "pnpm --filter web exec eslint --fix",
    "prettier --write"
  ]
}
}

PORT=4000
MONGODB_URI=mongodb://localhost:27017/heyama

# Comma-separated list of allowed origins for the web app (leave unset to allow any)
CORS_ORIGIN=http://localhost:3000

# MinIO in dev (matches docker-compose.yml), Supabase Storage in prod
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_BUCKET=heyama-objects
S3_FORCE_PATH_STYLE=true
# Only needed when the provider's public object URL differs from S3_ENDPOINT
# (e.g. Supabase Storage: https://<project-ref>.supabase.co/storage/v1/object/public/<bucket>)
# S3_PUBLIC_URL=
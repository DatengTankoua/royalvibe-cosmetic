PORT=4000
# MongoDB local = replica set mono-nœud « rs0 » (phase 0B.7C, docker-compose.yml).
# - replicaSet=rs0 : active le mode replica set, requis pour les transactions
#   multi-documents locales (écriture atomique vente–stock–audit, phase 0B.7B).
# - directConnection=true : l'API s'exécute sur l'hôte Windows et se connecte
#   via « localhost » ; le membre du replica set s'annonçant sous le nom Docker
#   « mongo:27017 », une connexion directe au nœud évite au driver de rechercher
#   des membres inconnus depuis l'hôte. Ce paramètre n'est PAS requis par les
#   transactions : la vraie condition est l'adhésion au replica set (rs0).
# La prod (Atlas) utilise son propre URI.
MONGODB_URI=mongodb://localhost:27017/stockmaster?replicaSet=rs0&directConnection=true

# Comma-separated list of allowed origins for the web app (leave unset to allow any)
CORS_ORIGIN=http://localhost:3000

# JWT — change this to a long random string in production
JWT_SECRET=change-me-in-production-use-a-long-random-string

# Object storage — MinIO in dev (matches docker-compose.yml), Cloudflare R2
# (PRIVATE bucket) in production. Images are never public: the API stores the
# object key and returns a SIGNED GET URL on every read. The browser loads
# images from the S3_ENDPOINT host, so it must be reachable by browsers.
# R2: S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com (EU
# jurisdiction: https://<ACCOUNT_ID>.eu.r2.cloudflarestorage.com), S3_REGION=auto.
# Changing S3_ENDPOINT or S3_BUCKET changes the storage identity: existing
# references are then neither read nor deleted (no cross-storage access).
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_BUCKET=stockmaster-objects
# Exactly `true` enables path-style addressing (MinIO); otherwise virtual-hosted.
S3_FORCE_PATH_STYLE=true
# Optional browser-facing origin used ONLY to sign GET URLs, when the API
# reaches the storage through an internal name (Docker Compose: S3_ENDPOINT=
# http://minio:9000, S3_SIGNING_ENDPOINT=https://s3.<domain> behind nginx).
# Leave empty for R2 (single endpoint). Storage identity stays S3_ENDPOINT.
# S3_SIGNING_ENDPOINT=
# Signed GET URL lifetime, integer 60–3600 seconds (default 900).
# S3_SIGNED_URL_TTL_SECONDS=900
# SDK checksums: when_supported (default, SDK behaviour) or when_required.
# Change only after the operator R2 trial shows it is needed.
# S3_CHECKSUM_MODE=when_supported

# Storage quotas (1-17B) — per organisation, server-side only.
# Quota in bytes (default 250000000 = 250 MB): photos (trash included) + logo.
# STORAGE_QUOTA_BYTES=250000000
# enforce (default) blocks uploads that would exceed the quota; track only
# counts (use while initialising existing files, see the 1-17B report).
# STORAGE_QUOTA_MODE=enforce
# Reservation lifetime before recovery may inspect it, 60–3600 s (default 900).
# STORAGE_RESERVATION_TTL_SECONDS=900
# Automatic recovery period in the HTTP process, 60–86400 s, 0 = off (default 600).
# STORAGE_RECOVERY_INTERVAL_SECONDS=600
# Storage inventory period (files present without a registry entry), only in
# enforce mode, 300–604800 s, 0 = off (default 21600 = 6 h).
# STORAGE_INVENTORY_INTERVAL_SECONDS=21600

# Anti-bot check of public sign-up (1-18C) — Cloudflare Turnstile.
# Without a key, every sign-up is refused (503): never an unchecked sign-up.
# Secret key of the Turnstile widget (SECRET, server only, never logged):
# TURNSTILE_SECRET_KEY=
# Exact hostnames allowed in the siteverify answer (comma-separated, no
# scheme/port/path). Required with the secret key; localhost refused in production.
# TURNSTILE_ALLOWED_HOSTNAMES=www.stock-master.app
# siteverify timeout, 500–10000 ms (default 5000). Timeout → 503, retryable.
# TURNSTILE_TIMEOUT_MS=5000
# Local development with Cloudflare's PUBLIC test keys (refused in production):
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
#   TURNSTILE_ALLOWED_HOSTNAMES=localhost
# Network-free simulation (tests, local recipe): ALWAYS refused with
# NODE_ENV=production; otherwise accepted only with NODE_ENV=test or when
# every configured origin is loopback.
# TURNSTILE_SIMULATED=false

# Persistent anti-abuse caps (1-18C), stored in MongoDB (rate_limit_buckets,
# shared by instances, kept across restarts; TTL index via migrate:predeploy).
# Failed password checks per normalised account (login + credentials
# routes), fixed window: 3–100 (default 10) per 60–3600 s (default 900).
# AUTH_ACCOUNT_FAILURE_LIMIT=10
# AUTH_ACCOUNT_FAILURE_WINDOW_SECONDS=900
# Beyond that cap, access recovery: each attempt needs a fresh Turnstile
# challenge (action "login", same widget) and stays capped per account AND
# client IP (/64 for IPv6): 1–20 failures (default 5) per the same window.
# Challenge + correct password closes the account window; a challenge alone
# resets nothing. Without Turnstile, no challenge: wait for the window end.
# AUTH_CHALLENGED_FAILURE_LIMIT=5
# Account-creation emails per invited address, all invitations and
# organisations together: 1–50 (default 5) per 3600–604800 s (default 86400).
# INVITATION_EMAIL_RECIPIENT_LIMIT=5
# INVITATION_EMAIL_RECIPIENT_WINDOW_SECONDS=86400

# Invitation links (1-12G) — REQUIRED to create invitations. Public origin of
# the web app (http(s), no path): the API returns
# `${PUBLIC_APP_URL}/auth/invitations/accept?token=…`, which the inviter copies
# and shares manually (no email is sent). Missing/invalid → invitation creation
# answers 503 INVITATION_LINK_UNAVAILABLE. Never derived from the Host header.
PUBLIC_APP_URL=http://localhost:3000

# Email verification (1-13A) — sent through Resend (https://api.resend.com).
# RESEND_API_KEY: secret, never committed, never logged. EMAIL_FROM: sender on a
# domain VERIFIED in Resend (`name@domain` or `Name <name@domain>`). The link
# `${PUBLIC_APP_URL}/auth/verify-email?token=…` reuses PUBLIC_APP_URL above.
# Missing/invalid → accounts are still created (unverified, resend later);
# POST /auth/email-verification/request answers 503 EMAIL_DELIVERY_UNAVAILABLE.
RESEND_API_KEY=
EMAIL_FROM=Stock Master <no-reply@example.com>

# Web Push notifications (1-16A) — DISABLED unless WEB_PUSH_ENABLED=true.
# When enabled, the three VAPID values are REQUIRED and validated at HTTP
# startup (invalid → the API refuses to start). Generate ONE pair and keep it
# stable (browser subscriptions are bound to the public key):
#   npx web-push generate-vapid-keys   (run from api/, prints base64url keys)
# The private key is a secret: never committed, never logged.
# Prerequisite: `pnpm --filter api migrate:push-notification-indexes`.
# 1-16A.1: the in-app notification center (bell, monthly reports) is ALWAYS
# on in the HTTP process, even with WEB_PUSH_ENABLED=false; in production the
# same migration is therefore required before starting the API.
# Single API instance only (background dispatcher runs in the HTTP process).
WEB_PUSH_ENABLED=false
# WEB_PUSH_VAPID_PUBLIC_KEY=
# WEB_PUSH_VAPID_PRIVATE_KEY=
# WEB_PUSH_VAPID_SUBJECT=mailto:ops@example.com

PORT=4000
# MongoDB local = replica set mono-nœud « rs0 » (phase 0B.7C, docker-compose.yml).
# - replicaSet=rs0 : active le mode replica set, requis pour les transactions
#   multi-documents locales (écriture atomique vente–stock–audit, phase 0B.7B).
# - directConnection=true : l'API s'exécute sur l'hôte Windows et se connecte
#   via « localhost » ; le membre du replica set s'annonçant sous le nom Docker
#   « mongo:27017 », une connexion directe au nœud évite au driver de rechercher
#   des membres inconnus depuis l'hôte. Ce paramètre n'est PAS requis par les
#   transactions : la vraie condition est l'adhésion au replica set (rs0).
# La prod (Atlas) utilise son propre URI.
MONGODB_URI=mongodb://localhost:27017/heyama?replicaSet=rs0&directConnection=true

# Comma-separated list of allowed origins for the web app (leave unset to allow any)
CORS_ORIGIN=http://localhost:3000

# JWT — change this to a long random string in production
JWT_SECRET=change-me-in-production-use-a-long-random-string

# MinIO in dev (matches docker-compose.yml), Supabase Storage in prod
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_BUCKET=heyama-objects
S3_FORCE_PATH_STYLE=true
# Only needed if the provider's public object URL differs from S3_ENDPOINT
# S3_PUBLIC_URL=

# Invitation email delivery (1-10B) — OPTIONAL. All 3 must be set together
# for Resend delivery to be attempted; if any is missing, invitations are
# still created and the accept link falls back to manual sharing
# (delivery.status = "manual", no network call). Never set a production
# default here.
# RESEND_API_KEY=
# EMAIL_FROM=
# PUBLIC_APP_URL=http://localhost:3000

  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "migrate:sale-operations-index": "node dist/migrations/create-sale-operations-index.js",
    "migrate:subscription-period-indexes": "node dist/migrations/create-subscription-period-indexes.js",
    "migrate:subscription-payment-indexes": "node dist/migrations/create-subscription-payment-indexes.js",
    "subscription:grant": "node dist/migrations/grant-subscription-period.js",
    "subscription:reconcile-payment": "node dist/migrations/reconcile-subscription-payment.js",
    "sales:backfill-product-history": "node dist/migrations/backfill-sale-product-history.js",
    "migrate:subscription-payment-reconciliation-indexes": "node dist/migrations/create-subscription-payment-reconciliation-indexes.js",
    "migrate:push-notification-indexes": "node dist/migrations/create-push-notification-indexes.js",
    "migrate:support-request-indexes": "node dist/migrations/create-support-request-indexes.js",
    "migrate:legal-acceptance-indexes": "node dist/migrations/create-legal-acceptance-indexes.js",
    "migrate:invitation-account-token-index": "node dist/migrations/create-invitation-account-token-index.js",
    "migrate:purge-terminated-invitations": "node dist/migrations/purge-terminated-invitations.js",
    "migrate:sales-notifications-permission": "node dist/migrations/sales-notifications-permission.js",
    "migrate:rate-limit-indexes": "node dist/migrations/create-rate-limit-indexes.js",
    "migrate:sale-history-indexes": "node dist/migrations/create-sale-history-indexes.js",
    "migrate:predeploy": "node dist/migrations/predeploy-migrations.js",
    "storage:quota": "node dist/migrations/storage-quota.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json --maxWorkers=1"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1099.0",
    "@aws-sdk/s3-request-presigner": "3.1100.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.2.6",
    "@nestjs/platform-socket.io": "^11.1.28",
    "@nestjs/throttler": "6.7.0",
    "@nestjs/websockets": "^11.1.28",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "mongoose": "^9.9.0",
    "multer": "^2.4.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "0.35.5",
    "socket.io": "^4.8.3",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcryptjs": "^3.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "@types/web-push": "3.6.4",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "mongodb-memory-server": "11.2.0",
    "prettier": "^3.4.2",
    "socket.io-client": "4.8.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
